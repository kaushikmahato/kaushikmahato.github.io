---
import Container from "../components/layouts/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/content/Prose.astro";
import AboutContent, { frontmatter } from "../content/about/index.md";
import { Icon } from "astro-icon/components";
import { SITE_SETTINGS } from "../site.config";

const title = frontmatter?.title ?? "About Me";
const description =
    frontmatter?.description ??
    "Deep-Tech Architect & Exited Founder | IIT Kharagpur | Enterprise R&D in Agentic AI & Fintech";

const institutions = [
    { name: "IIT Kharagpur", note: "B.Tech CS" },
    { name: "Visa", note: "Infrastructure" },
    { name: "VerSe", note: "Dailyhunt & Josh Group" },
    { name: "WEX", note: "Sr. Staff Engineer, R&D" },
];
---

<BaseLayout {title} {description}>
    <Container class="mx-auto max-w-4xl py-12">
        <header class="space-y-3">
            <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50">
                About Me
            </h1>

            <!-- Sub-headline / Tagline -->
            <p class="text-sm font-medium text-neutral-500 sm:text-base dark:text-neutral-400">
                Deep-Tech Architect &amp; Exited Founder <span class="text-neutral-300 dark:text-neutral-600">|</span> IIT Kharagpur <span class="text-neutral-300 dark:text-neutral-600">|</span> Enterprise R&amp;D in Agentic AI &amp; Fintech
            </p>

            <!-- Brief 2-line intro -->
            <p class="pt-1 text-base leading-relaxed text-neutral-700 sm:text-lg dark:text-neutral-300">
                A personal space documenting thoughts on distributed systems architecture, autonomous agentic workflows, and lessons learned from building software across startups and enterprise scale.
            </p>
        </header>

        <hr class="my-8 border-neutral-200 dark:border-neutral-800" />

        <!-- Markdown Content from index.md -->
        <Prose class:list={"mt-8"}>
            <AboutContent />
        </Prose>

        <!-- Experience & Heritage Section -->
        <div class="mt-16 border-t border-neutral-200 pt-10 dark:border-neutral-800">
            <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Experience &amp; Heritage
            </p>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {
                    institutions.map((item) => (
                        <div class="flex flex-col rounded-lg border border-neutral-200 bg-neutral-50/70 p-3.5 transition-colors hover:border-neutral-300 dark:border-neutral-800 dark:bg-neutral-800/40 dark:hover:border-neutral-700">
                            <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                                {item.name}
                            </span>
                            <span class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
                                {item.note}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Connect with me Section -->
        <div class="mt-12 border-t border-neutral-200 pt-10 dark:border-neutral-800">
            <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">Connect with me</h2>
            <p class="mt-2 text-base text-neutral-600 dark:text-neutral-400">
                Interested in discussing distributed architecture, multi-agent AI systems, or potential collaborations? Connect with me on LinkedIn or send a direct note via the Contact page.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                {
                    SITE_SETTINGS.socials.map((s) => (
                        <a
                            href={s.url}
                            target="_blank"
                            rel="me noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50/60 px-3.5 py-2.5 text-sm font-medium text-neutral-800 transition duration-200 hover:border-neutral-300 hover:bg-neutral-100 hover:text-neutral-950 dark:border-neutral-800 dark:bg-neutral-900/40 dark:text-neutral-300 dark:hover:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                            aria-label={s.label}
                        >
                            <Icon name={`fa6-brands:${s.icon}`} class="size-4" />
                            <span>{s.label}</span>
                        </a>
                    ))
                }
                <a
                    href="/contact"
                    class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-neutral-50/60 px-3.5 py-2.5 text-sm font-medium text-neutral-800 transition duration-200 hover:border-neutral-300 hover:bg-neutral-100 hover:text-neutral-950 dark:border-neutral-800 dark:bg-neutral-900/40 dark:text-neutral-300 dark:hover:border-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Send a message via the Contact page"
                >
                    <Icon name="lucide:mail" class="size-4" />
                    <span>Get in touch</span>
                </a>
            </div>
        </div>
    </Container>
</BaseLayout>
