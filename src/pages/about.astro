---
import Container from "../components/layouts/Container.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import SocialLinks from "../components/ui/SocialLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/content/Prose.astro";
import AboutContent, { frontmatter } from "../content/about/index.md";

const title = frontmatter?.title ?? "About Me";
const description =
    frontmatter?.description ??
    "Background, systems philosophy, and the ideas behind this personal knowledge space.";

const institutions = [
    { name: "IIT Kharagpur", note: "B.Tech CS" },
    { name: "Visa", note: "Infrastructure" },
    { name: "VerSe", note: "Dailyhunt & Josh Group" },
    { name: "WEX", note: "Sr. Staff Engineer, R&D" },
];
---

<BaseLayout {title} {description}>
    <Container class="mx-auto max-w-4xl py-12">
        <PageTitle title="About Me" />

        <!-- Sub-headline / Tagline -->
        <p class="mt-2 text-sm text-neutral-600 sm:text-base dark:text-neutral-400">
            Systems architecture, distributed engineering, and notes on autonomous agentic workflows.
        </p>

        <!-- Social Proof Bar -->
        <div class="mt-8 border-y border-neutral-200 py-6 dark:border-neutral-800">
            <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                Experience &amp; Heritage
            </p>
            <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {
                    institutions.map((item) => (
                        <div class="flex flex-col rounded-lg border border-neutral-200 bg-neutral-50/70 p-3.5 transition-colors hover:border-neutral-300 dark:border-neutral-800 dark:bg-neutral-800/40 dark:hover:border-neutral-700">
                            <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                                {item.name}
                            </span>
                            <span class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
                                {item.note}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Markdown Content from index.md -->
        <Prose class:list={"mt-12"}>
            <AboutContent />
        </Prose>

        <div class="mt-16 border-t border-neutral-200 pt-10 px-4 sm:px-6 md:px-0 dark:border-neutral-800">
            <h2 class="text-2xl font-bold">Connect with me</h2>
            <p class="mt-2 text-gray-700 dark:text-gray-300">
                Open to discussions around multi-agent architectures, distributed systems, and systems engineering.
            </p>

            <SocialLinks class="mt-6" appearance={"chip"} />
        </div>
    </Container>
</BaseLayout>
